<launch>

  <arg name="namespace"
       default="navigation"
       description="" />

  <arg name="use_nav"
       default="true"
       description="" />
  <arg name="use_sim_time"
       default="false"
       description="" />
  <arg name="namespace_hardware"
       default="hardware"
       description="" />
  <arg name="use_lidar"
       default="true"
       description="" />
  <arg name="use_point_cloud"
       default="true"
       description="" />
  <arg name="use_pot_fields"
       default="true"
       description="" />
  <arg name="cloud_downsampling"
       default="4"
       description="" />
  <arg name="cloud_filter_debug"
       default="false"
       description="" />
  <arg name="static_obstacle_ignore_radius"
       default="0.10"
       description="" />
  <arg name="cloud_points_threshold"
       default="20"
       description="" />
  <arg name="lidar_points_threshold"
       default="20"
       description="" />
  <arg name="obstacle_decay_factor"
       default="5"
       description="" />
  <arg name="robot_radius"
       default="0.35"
       description="" />
  <arg name="static_obstacle_inflation_radius"
       default="0.10"
       description="" />
  <arg name="dynamic_obstacle_inflation_radius"
       default="0.15"
       description="" />
  <arg name="cost_radius"
       default="0.35"
       description="" />
  <arg name="obstacle_inflation_radius"
       default="0.0"
       description="" />
  <arg name="map_augmenter_debug"
       default="false"
       description="" />
  <arg name="simple_move_max_linear_speed"
       default="0.6"
       description="" />
  <arg name="simple_move_max_angular_speed"
       default="0.6"
       description="" />
  <arg name="simple_move_linear_acceleration"
       default="0.10"
       description="" />
  <arg name="laser_min_x"
       default="0.17"
       description="" />
  <arg name="laser_max_x"
       default="0.55"
       description="" />
  <arg name="laser_min_y"
       default="-0.35"
       description="" />
  <arg name="laser_max_y"
       default="0.35"
       description="" />
  <arg name="laser_collision_min_y"
       default="-0.25"
       description="" />
  <arg name="laser_collision_max_y"
       default="0.25"
       description="" />
  <arg name="cloud_min_x"
       default="0.30"
       description="" />
  <arg name="cloud_max_x"
       default="1.50"
       description="" />
  <arg name="cloud_min_y"
       default="-0.35"
       description="" />
  <arg name="cloud_max_y"
       default="0.35"
       description="" />
  <arg name="cloud_collision_min_y"
       default="-0.25"
       description="" />
  <arg name="cloud_collision_max_y"
       default="0.25"
       description="" />
  <arg name="raw_point_cloud_topic"
       default="/$(var namespace_hardware)/camera/points"
       description="" />
  <arg name="cloud_filter_input_qos_mode"
       default="dual"
       description="" />

  <group if="$(var use_nav)">
    <include file="$(find-pkg-share navigation_start)/launch/navigation.launch.xml">
      <arg name="namespace_nav" value="$(var namespace)" />
      <arg name="namespace_hardware" value="$(var namespace_hardware)" />
      <arg name="use_sim_time" value="$(var use_sim_time)" />
      <arg name="use_lidar" value="$(var use_lidar)" />
      <arg name="use_point_cloud" value="$(var use_point_cloud)" />
      <arg name="use_pot_fields" value="$(var use_pot_fields)" />
      <arg name="cloud_downsampling" value="$(var cloud_downsampling)" />
      <arg name="cloud_filter_debug" value="$(var cloud_filter_debug)" />
      <arg name="static_obstacle_ignore_radius" value="$(var static_obstacle_ignore_radius)" />
      <arg name="cloud_points_threshold" value="$(var cloud_points_threshold)" />
      <arg name="lidar_points_threshold" value="$(var lidar_points_threshold)" />
      <arg name="obstacle_decay_factor" value="$(var obstacle_decay_factor)" />
      <arg name="robot_radius" value="$(var robot_radius)" />
      <arg name="static_obstacle_inflation_radius" value="$(var static_obstacle_inflation_radius)" />
      <arg name="dynamic_obstacle_inflation_radius" value="$(var dynamic_obstacle_inflation_radius)" />
      <arg name="cost_radius" value="$(var cost_radius)" />
      <arg name="obstacle_inflation_radius" value="$(var obstacle_inflation_radius)" />
      <arg name="map_augmenter_debug" value="$(var map_augmenter_debug)" />
      <arg name="simple_move_max_linear_speed" value="$(var simple_move_max_linear_speed)" />
      <arg name="simple_move_max_angular_speed" value="$(var simple_move_max_angular_speed)" />
      <arg name="simple_move_linear_acceleration" value="$(var simple_move_linear_acceleration)" />
      <arg name="laser_min_x" value="$(var laser_min_x)" />
      <arg name="laser_max_x" value="$(var laser_max_x)" />
      <arg name="laser_min_y" value="$(var laser_min_y)" />
      <arg name="laser_max_y" value="$(var laser_max_y)" />
      <arg name="laser_collision_min_y" value="$(var laser_collision_min_y)" />
      <arg name="laser_collision_max_y" value="$(var laser_collision_max_y)" />
      <arg name="cloud_min_x" value="$(var cloud_min_x)" />
      <arg name="cloud_max_x" value="$(var cloud_max_x)" />
      <arg name="cloud_min_y" value="$(var cloud_min_y)" />
      <arg name="cloud_max_y" value="$(var cloud_max_y)" />
      <arg name="cloud_collision_min_y" value="$(var cloud_collision_min_y)" />
      <arg name="cloud_collision_max_y" value="$(var cloud_collision_max_y)" />
      <arg name="raw_point_cloud_topic" value="$(var raw_point_cloud_topic)" />
      <arg name="cloud_filter_input_qos_mode" value="$(var cloud_filter_input_qos_mode)" />
    </include>

    <node
      pkg="locations_manager"
      exec="locations_manager_node"
      name="locations_manager_node"
      output="screen"
    >
      <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>

    <node
      pkg="nav_controller"
      exec="nav_controller_node"
      name="nav_controller_node"
      output="screen"
      >
      <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>
  </group>

</launch>
